+// Experimental browser WebGPU backend for the Pyodide build.
+//
+// Portions of the PrivateUse1 allocator/dispatch structure and binary
+// TensorIterator WGSL are adapted from torch-webgpu commit
+// a4369ff0f61f4e58cbffb048cee85047b33dacba
+// (https://github.com/jmaczan/torch-webgpu), licensed under Apache-2.0; see
+// third_party/torch-webgpu/LICENSE. This version is modified to use an
+// Emscripten EM_JS bridge because a Pyodide side module cannot import Dawn's
+// native wgpu API from the stock Pyodide main module.
+
+#include <ATen/ATen.h>
+#include <ATen/EmptyTensor.h>
+#include <ATen/TensorIterator.h>
+#include <ATen/core/grad_mode.h>
+#include <ATen/ops/as_strided_cpu_dispatch.h>
+#include <ATen/ops/view_cpu_dispatch.h>
+#include <c10/core/Allocator.h>
+#include <c10/core/Device.h>
+#include <c10/core/Stream.h>
+#include <c10/core/impl/DeviceGuardImplInterface.h>
+#include <emscripten.h>
+#include <torch/library.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <utility>
+#include <vector>
+
+namespace torch_webgpu::emscripten_backend {
+namespace {
+
+EM_JS(int, twgpu_is_ready, (), {
+  const state = globalThis.__torchWebGPU;
+  return state && state.device && state.queue && state.buffers ? 1 : 0;
+});
+
+EM_JS(std::uint32_t, twgpu_allocate, (std::uint32_t nbytes), {
+  const state = globalThis.__torchWebGPU;
+  if (!state || !state.device || !state.buffers) {
+    return 0;
+  }
+  const id = state.nextBufferId++;
+  const size = Math.max(4, nbytes >>> 0);
+  const buffer = state.device.createBuffer({
+    label: "PyTorch WebGPU tensor",
+    size,
+    usage: 0x0004 | 0x0008 | 0x0080,
+  });
+  state.buffers.set(id, buffer);
+  return id;
+});
+
+EM_JS(void, twgpu_release, (std::uint32_t id), {
+  const state = globalThis.__torchWebGPU;
+  if (!state || !state.buffers) {
+    return;
+  }
+  const buffer = state.buffers.get(id);
+  state.buffers.delete(id);
+  if (buffer) {
+    // WebGPU defers physical release until already-submitted work is done.
+    buffer.destroy();
+  }
+});
+
+EM_JS(
+    int,
+    twgpu_write_buffer,
+    (std::uint32_t id,
+     std::uint32_t destination_offset,
+     const void* source,
+     std::uint32_t nbytes),
+    {
+      const state = globalThis.__torchWebGPU;
+      const buffer = state && state.buffers && state.buffers.get(id);
+      if (!buffer) {
+        return 0;
+      }
+      state.queue.writeBuffer(
+          buffer,
+          destination_offset >>> 0,
+          HEAPU8,
+          source >>> 0,
+          nbytes >>> 0);
+      return 1;
+    });
+
+EM_JS(
+    int,
+    twgpu_copy_buffer,
+    (std::uint32_t source_id,
+     std::uint32_t source_offset,
+     std::uint32_t destination_id,
+     std::uint32_t destination_offset,
+     std::uint32_t nbytes),
+    {
+      const state = globalThis.__torchWebGPU;
+      const source = state && state.buffers && state.buffers.get(source_id);
+      const destination =
+          state && state.buffers && state.buffers.get(destination_id);
+      if (!source || !destination) {
+        return 0;
+      }
+      const encoder = state.device.createCommandEncoder({
+        label: "PyTorch WebGPU copy",
+      });
+      encoder.copyBufferToBuffer(
+          source,
+          source_offset >>> 0,
+          destination,
+          destination_offset >>> 0,
+          nbytes >>> 0);
+      state.queue.submit([encoder.finish()]);
+      state.copySubmissions++;
+      return 1;
+    });
+
+EM_JS(
+    int,
+    twgpu_binary,
+    (int operation,
+     std::uint32_t lhs_id,
+     std::uint32_t rhs_id,
+     std::uint32_t output_id,
+     const void* params,
+     std::uint32_t params_size,
+     std::uint32_t dispatch_x,
+     std::uint32_t dispatch_y),
+    {
+      const state = globalThis.__torchWebGPU;
+      const lhs = state && state.buffers && state.buffers.get(lhs_id);
+      const rhs = state && state.buffers && state.buffers.get(rhs_id);
+      const output = state && state.buffers && state.buffers.get(output_id);
+      if (!lhs || !rhs || !output) {
+        return 0;
+      }
+      const name = operation === 0 ? "add" : operation === 1 ? "mul" : "";
+      if (!name) {
+        return 0;
+      }
+      let pipeline = state.pipelines.get(name);
+      if (!pipeline) {
+        const expression =
+            operation === 0
+                ? "selfBuffer[idx_self] + params.alpha * otherBuffer[idx_other]"
+                : "selfBuffer[idx_self] * otherBuffer[idx_other]";
+        const code = `
+          const MAX_DIMS: u32 = 8u;
+          const WORKGROUP_SIZE: u32 = 64u;
+
+          struct Params {
+            length: u32,
+            ndim: u32,
+            alpha: f32,
+            dispatch_x: u32,
+
+            out_offset: u32,
+            self_offset: u32,
+            other_offset: u32,
+            _pad2: u32,
+
+            out_strides: array<u32, MAX_DIMS>,
+            self_strides: array<u32, MAX_DIMS>,
+            other_strides: array<u32, MAX_DIMS>,
+            shape: array<u32, MAX_DIMS>,
+          };
+
+          @group(0) @binding(0)
+          var<storage, read> selfBuffer: array<f32>;
+          @group(0) @binding(1)
+          var<storage, read> otherBuffer: array<f32>;
+          @group(0) @binding(2)
+          var<storage, read_write> outBuffer: array<f32>;
+          @group(0) @binding(3)
+          var<uniform> params: Params;
+
+          @compute @workgroup_size(64)
+          fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+            let i = gid.x + gid.y * params.dispatch_x * WORKGROUP_SIZE;
+            if (i >= params.length) {
+              return;
+            }
+
+            var remaining = i;
+            var coord: array<u32, MAX_DIMS>;
+            for (var d: i32 = i32(params.ndim) - 1; d >= 0; d--) {
+              let ud = u32(d);
+              let size = params.shape[ud];
+              coord[ud] = remaining % size;
+              remaining = remaining / size;
+            }
+
+            var idx_out = params.out_offset;
+            var idx_self = params.self_offset;
+            var idx_other = params.other_offset;
+            for (var d: u32 = 0u; d < params.ndim; d++) {
+              let coordinate = coord[d];
+              idx_out += coordinate * params.out_strides[d];
+              idx_self += coordinate * params.self_strides[d];
+              idx_other += coordinate * params.other_strides[d];
+            }
+            outBuffer[idx_out] = ${expression};
+          }
+        `;
+        const module = state.device.createShaderModule({
+          label: `PyTorch WebGPU ${name}`,
+          code,
+        });
+        pipeline = state.device.createComputePipeline({
+          label: `PyTorch WebGPU ${name}`,
+          layout: "auto",
+          compute: {module, entryPoint: "main"},
+        });
+        state.pipelines.set(name, pipeline);
+      }
+      const paramsBuffer = state.device.createBuffer({
+        label: "PyTorch WebGPU binary parameters",
+        size: params_size >>> 0,
+        usage: 0x0040 | 0x0008,
+      });
+      state.queue.writeBuffer(
+          paramsBuffer, 0, HEAPU8, params >>> 0, params_size >>> 0);
+      const bindGroup = state.device.createBindGroup({
+        label: `PyTorch WebGPU ${name}`,
+        layout: pipeline.getBindGroupLayout(0),
+        entries: [
+          {binding: 0, resource: {buffer: lhs}},
+          {binding: 1, resource: {buffer: rhs}},
+          {binding: 2, resource: {buffer: output}},
+          {binding: 3, resource: {buffer: paramsBuffer}},
+        ],
+      });
+      const encoder = state.device.createCommandEncoder({
+        label: `PyTorch WebGPU ${name}`,
+      });
+      const pass = encoder.beginComputePass();
+      pass.setPipeline(pipeline);
+      pass.setBindGroup(0, bindGroup);
+      pass.dispatchWorkgroups(dispatch_x >>> 0, dispatch_y >>> 0);
+      pass.end();
+      state.queue.submit([encoder.finish()]);
+      paramsBuffer.destroy();
+      state.kernelSubmissions++;
+      return 1;
+    });
+
+struct WebGPUAllocation {
+  std::uint32_t id;
+  std::size_t nbytes;
+};
+
+void delete_allocation(void* pointer) {
+  if (!pointer) {
+    return;
+  }
+  auto* allocation = static_cast<WebGPUAllocation*>(pointer);
+  twgpu_release(allocation->id);
+  delete allocation;
+}
+
+struct WebGPUAllocator final : c10::Allocator {
+  c10::DataPtr allocate(std::size_t nbytes) override {
+    if (nbytes == 0) {
+      return {
+          nullptr,
+          nullptr,
+          &delete_allocation,
+          c10::Device(c10::DeviceType::PrivateUse1, 0)};
+    }
+    TORCH_CHECK(
+        twgpu_is_ready(),
+        "WebGPU is not initialized; call `await torch.webgpu.init()` first");
+    TORCH_CHECK(
+        nbytes <= UINT32_MAX - std::size_t(3),
+        "WebGPU allocation is too large for the browser bridge: ",
+        nbytes,
+        " bytes");
+    const auto aligned_nbytes = (nbytes + 3) & ~std::size_t(3);
+    const auto id = twgpu_allocate(static_cast<std::uint32_t>(aligned_nbytes));
+    TORCH_CHECK(id != 0, "WebGPU buffer allocation failed");
+    auto* allocation = new WebGPUAllocation{id, aligned_nbytes};
+    return {
+        allocation,
+        allocation,
+        &delete_allocation,
+        c10::Device(c10::DeviceType::PrivateUse1, 0)};
+  }
+
+  c10::DeleterFnPtr raw_deleter() const override {
+    return &delete_allocation;
+  }
+
+  void copy_data(
+      void* destination,
+      const void* source,
+      std::size_t count) const override {
+    TORCH_CHECK_NOT_IMPLEMENTED(
+        false,
+        "WebGPU allocator copy_data is unavailable; use tensor copy operators");
+  }
+};
+
+WebGPUAllocator& allocator() {
+  static WebGPUAllocator instance;
+  return instance;
+}
+
+WebGPUAllocation& allocation(const at::Tensor& tensor) {
+  TORCH_CHECK(tensor.device().is_privateuseone(), "expected a WebGPU tensor");
+  auto* result =
+      static_cast<WebGPUAllocation*>(tensor.storage().data_ptr().get());
+  TORCH_CHECK(result, "WebGPU tensor has no GPUBuffer storage");
+  return *result;
+}
+
+std::uint32_t checked_nbytes(const at::Tensor& tensor) {
+  const auto bytes = tensor.numel() * tensor.element_size();
+  TORCH_CHECK(bytes >= 0 && bytes <= UINT32_MAX, "tensor is too large");
+  return static_cast<std::uint32_t>(bytes);
+}
+
+void check_supported_tensor(
+    const at::Tensor& tensor,
+    const char* operation,
+    bool require_contiguous = true) {
+  TORCH_CHECK(
+      tensor.device().is_privateuseone(),
+      operation,
+      " expected a WebGPU tensor");
+  TORCH_CHECK(
+      tensor.scalar_type() == at::kFloat,
+      operation,
+      " supports only torch.float32");
+  TORCH_CHECK(
+      !require_contiguous || tensor.is_contiguous(),
+      operation,
+      " requires contiguous tensors");
+  TORCH_CHECK(
+      tensor.storage_offset() >= 0,
+      operation,
+      " does not support negative storage offsets");
+}
+
+class WebGPUGuardImpl final : public c10::impl::DeviceGuardImplInterface {
+ public:
+  static constexpr c10::DeviceType static_type =
+      c10::DeviceType::PrivateUse1;
+
+  c10::DeviceType type() const override {
+    return static_type;
+  }
+
+  c10::Device exchangeDevice(c10::Device device) const override {
+    setDevice(device);
+    return c10::Device(static_type, 0);
+  }
+
+  c10::Device getDevice() const override {
+    return c10::Device(static_type, 0);
+  }
+
+  void setDevice(c10::Device device) const override {
+    TORCH_CHECK(
+        device.is_privateuseone() && device.index() <= 0,
+        "WebGPU supports only device 0");
+  }
+
+  void uncheckedSetDevice(c10::Device) const noexcept override {}
+
+  c10::DeviceIndex deviceCount() const noexcept override {
+    return twgpu_is_ready() ? 1 : 0;
+  }
+
+  c10::Stream getStream(c10::Device device) const noexcept override {
+    return c10::Stream(c10::Stream::DEFAULT, device);
+  }
+
+  c10::Stream exchangeStream(c10::Stream stream) const noexcept override {
+    return c10::Stream(c10::Stream::DEFAULT, stream.device());
+  }
+};
+
+at::Tensor empty_memory_format(
+    c10::IntArrayRef size,
+    std::optional<at::ScalarType> dtype,
+    std::optional<at::Layout> layout,
+    std::optional<at::Device> device,
+    std::optional<bool> pin_memory,
+    std::optional<c10::MemoryFormat> memory_format) {
+  const auto resolved_dtype = c10::dtype_or_default(dtype);
+  TORCH_CHECK(
+      resolved_dtype == at::kFloat, "WebGPU supports only torch.float32");
+  TORCH_CHECK(
+      c10::layout_or_default(layout) == c10::Layout::Strided,
+      "WebGPU supports only strided tensors");
+  TORCH_CHECK(
+      !c10::pinned_memory_or_default(pin_memory),
+      "WebGPU tensors cannot be pinned");
+  if (device) {
+    TORCH_CHECK(
+        device->is_privateuseone() && device->index() <= 0,
+        "WebGPU supports only device 0");
+  }
+  constexpr c10::DispatchKeySet key_set(c10::DispatchKey::PrivateUse1);
+  return at::detail::empty_generic(
+      size, &allocator(), key_set, resolved_dtype, memory_format);
+}
+
+at::Tensor empty_strided(
+    c10::IntArrayRef size,
+    c10::IntArrayRef stride,
+    std::optional<at::ScalarType> dtype,
+    std::optional<at::Layout> layout,
+    std::optional<at::Device> device,
+    std::optional<bool> pin_memory) {
+  const auto resolved_dtype = c10::dtype_or_default(dtype);
+  TORCH_CHECK(
+      resolved_dtype == at::kFloat, "WebGPU supports only torch.float32");
+  TORCH_CHECK(
+      c10::layout_or_default(layout) == c10::Layout::Strided,
+      "WebGPU supports only strided tensors");
+  TORCH_CHECK(
+      !c10::pinned_memory_or_default(pin_memory),
+      "WebGPU tensors cannot be pinned");
+  if (device) {
+    TORCH_CHECK(
+        device->is_privateuseone() && device->index() <= 0,
+        "WebGPU supports only device 0");
+  }
+  constexpr c10::DispatchKeySet key_set(c10::DispatchKey::PrivateUse1);
+  return at::detail::empty_strided_generic(
+      size, stride, &allocator(), key_set, resolved_dtype);
+}
+
+at::Tensor as_strided(
+    const at::Tensor& tensor,
+    c10::SymIntArrayRef size,
+    c10::SymIntArrayRef stride,
+    std::optional<c10::SymInt> storage_offset) {
+  check_supported_tensor(tensor, "WebGPU as_strided", false);
+  return at::cpu::as_strided_symint(
+      tensor, size, stride, std::move(storage_offset));
+}
+
+at::Tensor view(
+    const at::Tensor& tensor,
+    c10::SymIntArrayRef size) {
+  check_supported_tensor(tensor, "WebGPU view", false);
+  return at::cpu::view_symint(tensor, size);
+}
+
+at::Tensor copy_from(
+    const at::Tensor& source,
+    const at::Tensor& destination,
+    bool /*non_blocking*/) {
+  TORCH_CHECK(source.defined(), "source tensor is not defined");
+  TORCH_CHECK(destination.defined(), "destination tensor is not defined");
+
+  if (source.device().is_cpu() &&
+      destination.device().is_privateuseone()) {
+    check_supported_tensor(destination, "CPU to WebGPU copy");
+    TORCH_CHECK(
+        source.scalar_type() == at::kFloat,
+        "CPU to WebGPU copy supports only torch.float32");
+    TORCH_CHECK(
+        source.sizes() == destination.sizes(), "copy shape mismatch");
+    const auto contiguous_source =
+        source.is_contiguous() ? source : source.contiguous();
+    const auto nbytes = checked_nbytes(contiguous_source);
+    if (nbytes == 0) {
+      return destination;
+    }
+    auto& destination_allocation = allocation(destination);
+    const auto destination_offset =
+        destination.storage_offset() * destination.element_size();
+    TORCH_CHECK(
+        destination_offset >= 0 &&
+            static_cast<std::uint64_t>(destination_offset) +
+                    static_cast<std::uint64_t>(nbytes) <=
+                static_cast<std::uint64_t>(destination_allocation.nbytes),
+        "CPU to WebGPU copy exceeds destination storage");
+    TORCH_CHECK(
+        twgpu_write_buffer(
+            destination_allocation.id,
+            static_cast<std::uint32_t>(destination_offset),
+            contiguous_source.data_ptr(),
+            nbytes),
+        "CPU to WebGPU writeBuffer failed");
+    return destination;
+  }
+
+  if (source.device().is_privateuseone() &&
+      destination.device().is_privateuseone()) {
+    check_supported_tensor(source, "WebGPU copy");
+    check_supported_tensor(destination, "WebGPU copy");
+    TORCH_CHECK(
+        source.sizes() == destination.sizes(), "copy shape mismatch");
+    const auto nbytes = checked_nbytes(source);
+    if (nbytes == 0) {
+      return destination;
+    }
+    auto& source_allocation = allocation(source);
+    auto& destination_allocation = allocation(destination);
+    const auto source_offset = source.storage_offset() * source.element_size();
+    const auto destination_offset =
+        destination.storage_offset() * destination.element_size();
+    TORCH_CHECK(
+        source_offset >= 0 &&
+            static_cast<std::uint64_t>(source_offset) +
+                    static_cast<std::uint64_t>(nbytes) <=
+                static_cast<std::uint64_t>(source_allocation.nbytes),
+        "WebGPU copy exceeds source storage");
+    TORCH_CHECK(
+        destination_offset >= 0 &&
+            static_cast<std::uint64_t>(destination_offset) +
+                    static_cast<std::uint64_t>(nbytes) <=
+                static_cast<std::uint64_t>(destination_allocation.nbytes),
+        "WebGPU copy exceeds destination storage");
+    if (source_allocation.id == destination_allocation.id) {
+      TORCH_CHECK(
+          source_offset == destination_offset,
+          "WebGPU copy between different views of the same GPUBuffer is not "
+          "supported");
+      return destination;
+    }
+    TORCH_CHECK(
+        twgpu_copy_buffer(
+            source_allocation.id,
+            static_cast<std::uint32_t>(source_offset),
+            destination_allocation.id,
+            static_cast<std::uint32_t>(destination_offset),
+            nbytes),
+        "WebGPU buffer copy failed");
+    return destination;
+  }
+
+  if (source.device().is_privateuseone() && destination.device().is_cpu()) {
+    TORCH_CHECK(
+        false,
+        "browser WebGPU readback is asynchronous; use "
+        "`await torch.webgpu.to_cpu_async(tensor)` instead of `.cpu()`");
+  }
+
+  TORCH_CHECK(
+      false,
+      "unsupported WebGPU copy: ",
+      source.device(),
+      " -> ",
+      destination.device());
+}
+
+struct BinaryParams {
+  std::uint32_t length;
+  std::uint32_t ndim;
+  float alpha;
+  std::uint32_t dispatch_x;
+
+  std::uint32_t output_offset;
+  std::uint32_t lhs_offset;
+  std::uint32_t rhs_offset;
+  std::uint32_t padding;
+
+  std::uint32_t output_strides[8];
+  std::uint32_t lhs_strides[8];
+  std::uint32_t rhs_strides[8];
+  std::uint32_t shape[8];
+};
+
+static_assert(sizeof(BinaryParams) == 160);
+
+std::uint32_t checked_u32(std::int64_t value, const char* description) {
+  TORCH_CHECK(
+      value >= 0 &&
+          static_cast<std::uint64_t>(value) <=
+              std::numeric_limits<std::uint32_t>::max(),
+      description,
+      " does not fit in the WebGPU backend's uint32 metadata");
+  return static_cast<std::uint32_t>(value);
+}
+
+at::Tensor binary(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    int operation,
+    float alpha = 1.0f) {
+  check_supported_tensor(lhs, "WebGPU binary operation", false);
+  check_supported_tensor(rhs, "WebGPU binary operation", false);
+  TORCH_CHECK(
+      !at::GradMode::is_enabled() ||
+          (!lhs.requires_grad() && !rhs.requires_grad()),
+      "WebGPU autograd is not supported; use `torch.no_grad()` for inference");
+  const auto output_shape = at::infer_size(lhs.sizes(), rhs.sizes());
+  auto output = at::empty(output_shape, lhs.options());
+  if (output.numel() == 0) {
+    return output;
+  }
+
+  at::TensorIteratorConfig config;
+  config.set_check_mem_overlap(true);
+  config.add_output(output);
+  config.add_input(lhs);
+  config.add_input(rhs);
+  config.check_all_same_dtype(true);
+  config.check_all_same_device(true);
+  auto iterator = config.build();
+
+  TORCH_CHECK(
+      iterator.ntensors() == 3 &&
+          iterator.common_dtype() == at::ScalarType::Float &&
+          iterator.device_type() == c10::DeviceType::PrivateUse1,
+      "invalid TensorIterator for WebGPU binary operation");
+  const auto ndim = iterator.ndim();
+  TORCH_CHECK(ndim >= 0 && ndim <= 8, "WebGPU supports at most 8 dimensions");
+
+  const auto element_size = iterator.element_size(0);
+  TORCH_CHECK(element_size == sizeof(float));
+  const auto output_strides_bytes = iterator.strides(0);
+  const auto lhs_strides_bytes = iterator.strides(1);
+  const auto rhs_strides_bytes = iterator.strides(2);
+  const auto shape = iterator.shape();
+
+  const auto numel = checked_u32(iterator.numel(), "tensor element count");
+  const auto num_workgroups =
+      (numel + std::uint32_t(63)) / std::uint32_t(64);
+  const auto dispatch_x = std::min(num_workgroups, std::uint32_t(65535));
+  const auto dispatch_y =
+      (num_workgroups + std::uint32_t(65534)) / std::uint32_t(65535);
+
+  BinaryParams params{};
+  params.length = numel;
+  params.ndim = static_cast<std::uint32_t>(ndim);
+  params.alpha = alpha;
+  params.dispatch_x = dispatch_x;
+  params.output_offset =
+      checked_u32(output.storage_offset(), "output storage offset");
+  params.lhs_offset = checked_u32(lhs.storage_offset(), "lhs storage offset");
+  params.rhs_offset = checked_u32(rhs.storage_offset(), "rhs storage offset");
+  for (std::size_t dimension = 0; dimension < 8; ++dimension) {
+    params.shape[dimension] = 1;
+  }
+  for (std::int64_t dimension = 0; dimension < ndim; ++dimension) {
+    TORCH_CHECK(
+        output_strides_bytes[dimension] % element_size == 0 &&
+            lhs_strides_bytes[dimension] % element_size == 0 &&
+            rhs_strides_bytes[dimension] % element_size == 0,
+        "WebGPU tensor stride is not a multiple of element size");
+    params.output_strides[dimension] = checked_u32(
+        output_strides_bytes[dimension] / element_size, "output stride");
+    params.lhs_strides[dimension] = checked_u32(
+        lhs_strides_bytes[dimension] / element_size, "lhs stride");
+    params.rhs_strides[dimension] = checked_u32(
+        rhs_strides_bytes[dimension] / element_size, "rhs stride");
+    params.shape[dimension] = checked_u32(shape[dimension], "shape dimension");
+  }
+
+  auto& lhs_allocation = allocation(lhs);
+  auto& rhs_allocation = allocation(rhs);
+  auto& output_allocation = allocation(output);
+  TORCH_CHECK(
+      twgpu_binary(
+          operation,
+          lhs_allocation.id,
+          rhs_allocation.id,
+          output_allocation.id,
+          &params,
+          sizeof(params),
+          dispatch_x,
+          dispatch_y),
+      "WebGPU binary dispatch failed");
+  return output;
+}
+
+at::Tensor add(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    const at::Scalar& alpha) {
+  return binary(lhs, rhs, 0, alpha.to<float>());
+}
+
+at::Tensor multiply(const at::Tensor& lhs, const at::Tensor& rhs) {
+  return binary(lhs, rhs, 1);
+}
+
+std::int64_t buffer_id(const at::Tensor& tensor) {
+  if (tensor.numel() == 0) {
+    return 0;
+  }
+  return allocation(tensor).id;
+}
+
+std::int64_t buffer_nbytes(const at::Tensor& tensor) {
+  return checked_nbytes(tensor);
+}
+
