+// Side-module compute profile for Emdawnwebgpu's Dawn-style C/C++ headers.
+//
+// Emdawnwebgpu's full library_webgpu*.js implementation is a final-link
+// JavaScript library and therefore cannot be installed by a Pyodide side
+// module. Emscripten's dynamic loader does, however, reconstruct EM_JS bodies
+// exported by a side module. This file implements only the WebGPU C entry
+// points used by the imported torch-webgpu eager kernels and stores browser
+// objects behind opaque 32-bit handles.
+
+#include <emscripten.h>
+#include <webgpu/webgpu.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+namespace {
+
+struct LayoutEntry {
+  std::uint32_t binding;
+  std::uint32_t visibility;
+  std::uint32_t buffer_type;
+  std::uint32_t min_binding_size;
+};
+
+struct BindEntry {
+  std::uint32_t binding;
+  std::uint32_t buffer;
+  std::uint32_t offset;
+  std::uint32_t size;
+};
+
+static_assert(sizeof(LayoutEntry) == 16);
+static_assert(sizeof(BindEntry) == 16);
+
+template <typename Handle>
+std::uint32_t handle_id(Handle handle) {
+  return static_cast<std::uint32_t>(
+      reinterpret_cast<std::uintptr_t>(handle));
+}
+
+template <typename Handle>
+Handle make_handle(std::uint32_t id) {
+  return reinterpret_cast<Handle>(static_cast<std::uintptr_t>(id));
+}
+
+std::uint32_t checked_u32(std::uint64_t value) {
+  if (value > std::numeric_limits<std::uint32_t>::max()) {
+    return 0;
+  }
+  return static_cast<std::uint32_t>(value);
+}
+
+std::size_t string_length(WGPUStringView value) {
+  if (value.data == nullptr) {
+    return 0;
+  }
+  return value.length == WGPU_STRLEN ? std::strlen(value.data) : value.length;
+}
+
+EM_JS(void, twgpu_add_ref, (std::uint32_t id), {
+  const state = globalThis.__torchWebGPU;
+  const record = state && state.objects && state.objects.get(id >>> 0);
+  if (record) record.refs++;
+});
+
+EM_JS(void, twgpu_release, (std::uint32_t id), {
+  const state = globalThis.__torchWebGPU;
+  const record = state && state.objects && state.objects.get(id >>> 0);
+  if (!record) return;
+  if (record.imported) {
+    // JavaScript owns the base reference for the imported device and queue.
+    // Balance temporary webgpu_cpp RAII copies without deleting that owner.
+    if (record.refs > 1) record.refs--;
+    return;
+  }
+  record.refs--;
+  if (record.refs > 0) return;
+  state.objects.delete(id >>> 0);
+  if (record.type === "buffer") {
+    state.buffers.delete(id >>> 0);
+    if (record.value) record.value.destroy();
+    state.bufferReleases++;
+  }
+  state.resourceReleases++;
+});
+
+EM_JS(
+    std::uint32_t,
+    twgpu_create_buffer,
+    (std::uint32_t size,
+     std::uint32_t usage,
+     int mapped_at_creation),
+    {
+      const state = globalThis.__torchWebGPU;
+      if (!state || !state.device || !state.objects || !state.buffers) return 0;
+      const id = state.nextObjectId++ >>> 0;
+      const buffer = state.device.createBuffer({
+        label: "PyTorch WebGPU buffer",
+        size: Math.max(4, size >>> 0),
+        usage: usage >>> 0,
+        mappedAtCreation: !!mapped_at_creation,
+      });
+      state.objects.set(id, {
+        value: buffer,
+        type: "buffer",
+        refs: 1,
+        size: Math.max(4, size >>> 0),
+        imported: false,
+      });
+      state.buffers.set(id, buffer);
+      state.bufferAllocations++;
+      return id;
+    });
+
+EM_JS(void, twgpu_destroy_buffer, (std::uint32_t id), {
+  const state = globalThis.__torchWebGPU;
+  const record = state && state.objects && state.objects.get(id >>> 0);
+  if (record && record.type === "buffer" && record.value) {
+    record.value.destroy();
+  }
+});
+
+EM_JS(double, twgpu_buffer_size, (std::uint32_t id), {
+  const state = globalThis.__torchWebGPU;
+  const record = state && state.objects && state.objects.get(id >>> 0);
+  return record && record.type === "buffer" ? record.size : 0;
+});
+
+EM_JS(
+    std::uint32_t,
+    twgpu_create_shader_module,
+    (const char* code, std::uint32_t length),
+    {
+      const state = globalThis.__torchWebGPU;
+      const shader = state.device.createShaderModule({
+        label: "torch-webgpu WGSL",
+        code: UTF8ToString(code >>> 0, length >>> 0),
+      });
+      const id = state.nextObjectId++ >>> 0;
+      state.objects.set(id, {
+        value: shader, type: "shader", refs: 1, imported: false,
+      });
+      state.shaderCompilations++;
+      return id;
+    });
+
+EM_JS(
+    std::uint32_t,
+    twgpu_create_bind_group_layout,
+    (const LayoutEntry* entries, std::uint32_t count),
+    {
+      const state = globalThis.__torchWebGPU;
+      const result = [];
+      const base = entries >>> 2;
+      for (let i = 0; i < (count >>> 0); i++) {
+        const offset = base + i * 4;
+        const typeCode = HEAPU32[offset + 2];
+        const type = typeCode === 2 ? "uniform" :
+          typeCode === 3 ? "storage" :
+          typeCode === 4 ? "read-only-storage" : undefined;
+        if (!type) throw new Error(`unsupported WGPUBufferBindingType ${typeCode}`);
+        result.push({
+          binding: HEAPU32[offset],
+          visibility: HEAPU32[offset + 1],
+          buffer: {
+            type,
+            hasDynamicOffset: false,
+            minBindingSize: HEAPU32[offset + 3],
+          },
+        });
+      }
+      const value = state.device.createBindGroupLayout({entries: result});
+      const id = state.nextObjectId++ >>> 0;
+      state.objects.set(id, {
+        value, type: "bind-group-layout", refs: 1, imported: false,
+      });
+      return id;
+    });
+
+EM_JS(
+    std::uint32_t,
+    twgpu_create_pipeline_layout,
+    (const std::uint32_t* layouts, std::uint32_t count),
+    {
+      const state = globalThis.__torchWebGPU;
+      const values = [];
+      const base = layouts >>> 2;
+      for (let i = 0; i < (count >>> 0); i++) {
+        const record = state.objects.get(HEAPU32[base + i]);
+        if (!record) throw new Error("released bind group layout");
+        values.push(record.value);
+      }
+      const value = state.device.createPipelineLayout({bindGroupLayouts: values});
+      const id = state.nextObjectId++ >>> 0;
+      state.objects.set(id, {
+        value, type: "pipeline-layout", refs: 1, imported: false,
+      });
+      return id;
+    });
+
+EM_JS(
+    std::uint32_t,
+    twgpu_create_compute_pipeline,
+    (std::uint32_t layout_id,
+     std::uint32_t shader_id,
+     const char* entry_point,
+     std::uint32_t entry_point_length),
+    {
+      const state = globalThis.__torchWebGPU;
+      const layout = state.objects.get(layout_id >>> 0);
+      const shader = state.objects.get(shader_id >>> 0);
+      if (!layout || !shader) throw new Error("released pipeline dependency");
+      const value = state.device.createComputePipeline({
+        layout: layout.value,
+        compute: {
+          "module": shader.value,
+          entryPoint: UTF8ToString(entry_point >>> 0, entry_point_length >>> 0),
+        },
+      });
+      const id = state.nextObjectId++ >>> 0;
+      state.objects.set(id, {
+        value, type: "compute-pipeline", refs: 1, imported: false,
+      });
+      state.pipelineCreations++;
+      return id;
+    });
+
+EM_JS(
+    std::uint32_t,
+    twgpu_create_bind_group,
+    (std::uint32_t layout_id,
+     const BindEntry* entries,
+     std::uint32_t count),
+    {
+      const state = globalThis.__torchWebGPU;
+      const layout = state.objects.get(layout_id >>> 0);
+      if (!layout) throw new Error("released bind group layout");
+      const result = [];
+      const base = entries >>> 2;
+      for (let i = 0; i < (count >>> 0); i++) {
+        const offset = base + i * 4;
+        const buffer = state.objects.get(HEAPU32[offset + 1]);
+        if (!buffer) throw new Error("released bind group buffer");
+        result.push({
+          binding: HEAPU32[offset],
+          resource: {
+            buffer: buffer.value,
+            offset: HEAPU32[offset + 2],
+            size: HEAPU32[offset + 3],
+          },
+        });
+      }
+      const value = state.device.createBindGroup({
+        layout: layout.value, entries: result,
+      });
+      const id = state.nextObjectId++ >>> 0;
+      state.objects.set(id, {
+        value, type: "bind-group", refs: 1, imported: false,
+      });
+      return id;
+    });
+
+EM_JS(std::uint32_t, twgpu_create_command_encoder, (), {
+  const state = globalThis.__torchWebGPU;
+  const value = state.device.createCommandEncoder();
+  const id = state.nextObjectId++ >>> 0;
+  state.objects.set(id, {
+    value, type: "command-encoder", refs: 1, imported: false,
+  });
+  return id;
+});
+
+EM_JS(
+    std::uint32_t,
+    twgpu_begin_compute_pass,
+    (std::uint32_t encoder_id),
+    {
+      const state = globalThis.__torchWebGPU;
+      const encoder = state.objects.get(encoder_id >>> 0);
+      if (!encoder) throw new Error("released command encoder");
+      const value = encoder.value.beginComputePass();
+      const id = state.nextObjectId++ >>> 0;
+      state.objects.set(id, {
+        value, type: "compute-pass", refs: 1, imported: false,
+      });
+      return id;
+    });
+
+EM_JS(
+    void,
+    twgpu_compute_pass_set_pipeline,
+    (std::uint32_t pass_id, std::uint32_t pipeline_id),
+    {
+      const state = globalThis.__torchWebGPU;
+      state.objects.get(pass_id >>> 0).value.setPipeline(
+        state.objects.get(pipeline_id >>> 0).value);
+    });
+
+EM_JS(
+    void,
+    twgpu_compute_pass_set_bind_group,
+    (std::uint32_t pass_id,
+     std::uint32_t group_index,
+     std::uint32_t bind_group_id),
+    {
+      const state = globalThis.__torchWebGPU;
+      state.objects.get(pass_id >>> 0).value.setBindGroup(
+        group_index >>> 0, state.objects.get(bind_group_id >>> 0).value);
+    });
+
+EM_JS(
+    void,
+    twgpu_compute_pass_dispatch,
+    (std::uint32_t pass_id,
+     std::uint32_t x,
+     std::uint32_t y,
+     std::uint32_t z),
+    {
+      const state = globalThis.__torchWebGPU;
+      state.objects.get(pass_id >>> 0).value.dispatchWorkgroups(
+        x >>> 0, y >>> 0, z >>> 0);
+      state.dispatches++;
+    });
+
+EM_JS(void, twgpu_compute_pass_end, (std::uint32_t pass_id), {
+  const state = globalThis.__torchWebGPU;
+  state.objects.get(pass_id >>> 0).value.end();
+});
+
+EM_JS(
+    void,
+    twgpu_encoder_copy_buffer,
+    (std::uint32_t encoder_id,
+     std::uint32_t source_id,
+     std::uint32_t source_offset,
+     std::uint32_t destination_id,
+     std::uint32_t destination_offset,
+     std::uint32_t size),
+    {
+      const state = globalThis.__torchWebGPU;
+      state.objects.get(encoder_id >>> 0).value.copyBufferToBuffer(
+        state.objects.get(source_id >>> 0).value,
+        source_offset >>> 0,
+        state.objects.get(destination_id >>> 0).value,
+        destination_offset >>> 0,
+        size >>> 0);
+      state.gpuCopies++;
+    });
+
+EM_JS(
+    std::uint32_t,
+    twgpu_finish_command_encoder,
+    (std::uint32_t encoder_id),
+    {
+      const state = globalThis.__torchWebGPU;
+      const encoder = state.objects.get(encoder_id >>> 0);
+      const value = encoder.value.finish();
+      const id = state.nextObjectId++ >>> 0;
+      state.objects.set(id, {
+        value, type: "command-buffer", refs: 1, imported: false,
+      });
+      return id;
+    });
+
+EM_JS(
+    void,
+    twgpu_queue_submit,
+    (const std::uint32_t* commands, std::uint32_t count),
+    {
+      const state = globalThis.__torchWebGPU;
+      const result = [];
+      const base = commands >>> 2;
+      for (let i = 0; i < (count >>> 0); i++) {
+        const record = state.objects.get(HEAPU32[base + i]);
+        if (!record) throw new Error("released command buffer");
+        result.push(record.value);
+      }
+      state.queue.submit(result);
+      state.commandSubmissions++;
+    });
+
+EM_JS(
+    void,
+    twgpu_queue_write_buffer,
+    (std::uint32_t buffer_id,
+     std::uint32_t buffer_offset,
+     const void* data,
+     std::uint32_t size),
+    {
+      const state = globalThis.__torchWebGPU;
+      const buffer = state.objects.get(buffer_id >>> 0);
+      if (!buffer) throw new Error("released destination buffer");
+      // HEAPU8 is read synchronously. Do not retain this view across an await;
+      // Pyodide uses growable Wasm memory and refreshes its global heap views.
+      state.queue.writeBuffer(
+        buffer.value,
+        buffer_offset >>> 0,
+        HEAPU8,
+        data >>> 0,
+        size >>> 0);
+      state.uploads++;
+    });
+
+} // namespace
+
+extern "C" {
+
+WGPUBuffer wgpuDeviceCreateBuffer(
+    WGPUDevice,
+    const WGPUBufferDescriptor* descriptor) {
+  if (descriptor == nullptr || descriptor->mappedAtCreation ||
+      descriptor->nextInChain != nullptr) {
+    return nullptr;
+  }
+  const auto size = checked_u32(descriptor->size);
+  const auto usage = checked_u32(descriptor->usage);
+  if (size == 0 && descriptor->size != 0) {
+    return nullptr;
+  }
+  return make_handle<WGPUBuffer>(twgpu_create_buffer(size, usage, 0));
+}
+
+void wgpuBufferDestroy(WGPUBuffer buffer) {
+  twgpu_destroy_buffer(handle_id(buffer));
+}
+
+std::uint64_t wgpuBufferGetSize(WGPUBuffer buffer) {
+  return static_cast<std::uint64_t>(twgpu_buffer_size(handle_id(buffer)));
+}
+
+WGPUShaderModule wgpuDeviceCreateShaderModule(
+    WGPUDevice,
+    const WGPUShaderModuleDescriptor* descriptor) {
+  if (descriptor == nullptr || descriptor->nextInChain == nullptr ||
+      descriptor->nextInChain->sType != WGPUSType_ShaderSourceWGSL) {
+    return nullptr;
+  }
+  const auto* source = reinterpret_cast<const WGPUShaderSourceWGSL*>(
+      descriptor->nextInChain);
+  const auto length = string_length(source->code);
+  if (source->code.data == nullptr ||
+      length > std::numeric_limits<std::uint32_t>::max()) {
+    return nullptr;
+  }
+  return make_handle<WGPUShaderModule>(twgpu_create_shader_module(
+      source->code.data, static_cast<std::uint32_t>(length)));
+}
+
+WGPUBindGroupLayout wgpuDeviceCreateBindGroupLayout(
+    WGPUDevice,
+    const WGPUBindGroupLayoutDescriptor* descriptor) {
+  if (descriptor == nullptr || descriptor->nextInChain != nullptr ||
+      descriptor->entryCount > std::numeric_limits<std::uint32_t>::max()) {
+    return nullptr;
+  }
+  std::vector<LayoutEntry> entries;
+  entries.reserve(descriptor->entryCount);
+  for (std::size_t index = 0; index < descriptor->entryCount; ++index) {
+    const auto& entry = descriptor->entries[index];
+    if (entry.nextInChain != nullptr || entry.bindingArraySize != 0 ||
+        entry.buffer.nextInChain != nullptr ||
+        entry.buffer.hasDynamicOffset) {
+      return nullptr;
+    }
+    const auto min_size = checked_u32(entry.buffer.minBindingSize);
+    if (min_size == 0 && entry.buffer.minBindingSize != 0) {
+      return nullptr;
+    }
+    entries.push_back({
+        entry.binding,
+        checked_u32(entry.visibility),
+        static_cast<std::uint32_t>(entry.buffer.type),
+        min_size});
+  }
+  return make_handle<WGPUBindGroupLayout>(twgpu_create_bind_group_layout(
+      entries.data(), static_cast<std::uint32_t>(entries.size())));
+}
+
+WGPUPipelineLayout wgpuDeviceCreatePipelineLayout(
+    WGPUDevice,
+    const WGPUPipelineLayoutDescriptor* descriptor) {
+  if (descriptor == nullptr || descriptor->nextInChain != nullptr ||
+      descriptor->bindGroupLayoutCount >
+          std::numeric_limits<std::uint32_t>::max()) {
+    return nullptr;
+  }
+  std::vector<std::uint32_t> layouts;
+  layouts.reserve(descriptor->bindGroupLayoutCount);
+  for (std::size_t index = 0; index < descriptor->bindGroupLayoutCount;
+       ++index) {
+    layouts.push_back(handle_id(descriptor->bindGroupLayouts[index]));
+  }
+  return make_handle<WGPUPipelineLayout>(twgpu_create_pipeline_layout(
+      layouts.data(), static_cast<std::uint32_t>(layouts.size())));
+}
+
+WGPUComputePipeline wgpuDeviceCreateComputePipeline(
+    WGPUDevice,
+    const WGPUComputePipelineDescriptor* descriptor) {
+  if (descriptor == nullptr || descriptor->nextInChain != nullptr ||
+      descriptor->compute.nextInChain != nullptr ||
+      descriptor->compute.constantCount != 0 ||
+      descriptor->layout == nullptr || descriptor->compute.module == nullptr) {
+    return nullptr;
+  }
+  const auto length = string_length(descriptor->compute.entryPoint);
+  if (descriptor->compute.entryPoint.data == nullptr ||
+      length > std::numeric_limits<std::uint32_t>::max()) {
+    return nullptr;
+  }
+  return make_handle<WGPUComputePipeline>(twgpu_create_compute_pipeline(
+      handle_id(descriptor->layout),
+      handle_id(descriptor->compute.module),
+      descriptor->compute.entryPoint.data,
+      static_cast<std::uint32_t>(length)));
+}
+
+WGPUBindGroup wgpuDeviceCreateBindGroup(
+    WGPUDevice,
+    const WGPUBindGroupDescriptor* descriptor) {
+  if (descriptor == nullptr || descriptor->nextInChain != nullptr ||
+      descriptor->layout == nullptr ||
+      descriptor->entryCount > std::numeric_limits<std::uint32_t>::max()) {
+    return nullptr;
+  }
+  std::vector<BindEntry> entries;
+  entries.reserve(descriptor->entryCount);
+  for (std::size_t index = 0; index < descriptor->entryCount; ++index) {
+    const auto& entry = descriptor->entries[index];
+    const auto offset = checked_u32(entry.offset);
+    const auto size = checked_u32(entry.size);
+    if (entry.nextInChain != nullptr || entry.buffer == nullptr ||
+        entry.sampler != nullptr || entry.textureView != nullptr ||
+        (offset == 0 && entry.offset != 0) ||
+        (size == 0 && entry.size != 0)) {
+      return nullptr;
+    }
+    entries.push_back({entry.binding, handle_id(entry.buffer), offset, size});
+  }
+  return make_handle<WGPUBindGroup>(twgpu_create_bind_group(
+      handle_id(descriptor->layout),
+      entries.data(),
+      static_cast<std::uint32_t>(entries.size())));
+}
+
+WGPUCommandEncoder wgpuDeviceCreateCommandEncoder(
+    WGPUDevice,
+    const WGPUCommandEncoderDescriptor* descriptor) {
+  if (descriptor != nullptr && descriptor->nextInChain != nullptr) {
+    return nullptr;
+  }
+  return make_handle<WGPUCommandEncoder>(twgpu_create_command_encoder());
+}
+
+WGPUComputePassEncoder wgpuCommandEncoderBeginComputePass(
+    WGPUCommandEncoder encoder,
+    const WGPUComputePassDescriptor* descriptor) {
+  if (descriptor != nullptr &&
+      (descriptor->nextInChain != nullptr ||
+       descriptor->timestampWrites != nullptr)) {
+    return nullptr;
+  }
+  return make_handle<WGPUComputePassEncoder>(
+      twgpu_begin_compute_pass(handle_id(encoder)));
+}
+
+void wgpuComputePassEncoderSetPipeline(
+    WGPUComputePassEncoder pass,
+    WGPUComputePipeline pipeline) {
+  twgpu_compute_pass_set_pipeline(handle_id(pass), handle_id(pipeline));
+}
+
+void wgpuComputePassEncoderSetBindGroup(
+    WGPUComputePassEncoder pass,
+    std::uint32_t group_index,
+    WGPUBindGroup bind_group,
+    std::size_t dynamic_offset_count,
+    const std::uint32_t*) {
+  if (dynamic_offset_count != 0) {
+    return;
+  }
+  twgpu_compute_pass_set_bind_group(
+      handle_id(pass), group_index, handle_id(bind_group));
+}
+
+void wgpuComputePassEncoderDispatchWorkgroups(
+    WGPUComputePassEncoder pass,
+    std::uint32_t x,
+    std::uint32_t y,
+    std::uint32_t z) {
+  twgpu_compute_pass_dispatch(handle_id(pass), x, y, z);
+}
+
+void wgpuComputePassEncoderEnd(WGPUComputePassEncoder pass) {
+  twgpu_compute_pass_end(handle_id(pass));
+}
+
+void wgpuCommandEncoderCopyBufferToBuffer(
+    WGPUCommandEncoder encoder,
+    WGPUBuffer source,
+    std::uint64_t source_offset,
+    WGPUBuffer destination,
+    std::uint64_t destination_offset,
+    std::uint64_t size) {
+  const auto source_offset_u32 = checked_u32(source_offset);
+  const auto destination_offset_u32 = checked_u32(destination_offset);
+  const auto size_u32 = checked_u32(size);
+  if ((source_offset_u32 == 0 && source_offset != 0) ||
+      (destination_offset_u32 == 0 && destination_offset != 0) ||
+      (size_u32 == 0 && size != 0)) {
+    return;
+  }
+  twgpu_encoder_copy_buffer(
+      handle_id(encoder),
+      handle_id(source),
+      source_offset_u32,
+      handle_id(destination),
+      destination_offset_u32,
+      size_u32);
+}
+
+WGPUCommandBuffer wgpuCommandEncoderFinish(
+    WGPUCommandEncoder encoder,
+    const WGPUCommandBufferDescriptor* descriptor) {
+  if (descriptor != nullptr && descriptor->nextInChain != nullptr) {
+    return nullptr;
+  }
+  return make_handle<WGPUCommandBuffer>(
+      twgpu_finish_command_encoder(handle_id(encoder)));
+}
+
+void wgpuQueueSubmit(
+    WGPUQueue,
+    std::size_t command_count,
+    const WGPUCommandBuffer* commands) {
+  if (command_count > std::numeric_limits<std::uint32_t>::max()) {
+    return;
+  }
+  std::vector<std::uint32_t> ids;
+  ids.reserve(command_count);
+  for (std::size_t index = 0; index < command_count; ++index) {
+    ids.push_back(handle_id(commands[index]));
+  }
+  twgpu_queue_submit(ids.data(), static_cast<std::uint32_t>(ids.size()));
+}
+
+void wgpuQueueWriteBuffer(
+    WGPUQueue,
+    WGPUBuffer buffer,
+    std::uint64_t buffer_offset,
+    const void* data,
+    std::size_t size) {
+  const auto offset_u32 = checked_u32(buffer_offset);
+  const auto size_u32 = checked_u32(size);
+  if ((offset_u32 == 0 && buffer_offset != 0) ||
+      (size_u32 == 0 && size != 0)) {
+    return;
+  }
+  twgpu_queue_write_buffer(
+      handle_id(buffer), offset_u32, data, size_u32);
+}
+
+#define TWGPU_REFCOUNT_FUNCTIONS(Name, CType)                         \
+  void wgpu##Name##AddRef(CType handle) { twgpu_add_ref(handle_id(handle)); } \
+  void wgpu##Name##Release(CType handle) { twgpu_release(handle_id(handle)); }
+
+TWGPU_REFCOUNT_FUNCTIONS(BindGroup, WGPUBindGroup)
+TWGPU_REFCOUNT_FUNCTIONS(BindGroupLayout, WGPUBindGroupLayout)
+TWGPU_REFCOUNT_FUNCTIONS(Buffer, WGPUBuffer)
+TWGPU_REFCOUNT_FUNCTIONS(CommandBuffer, WGPUCommandBuffer)
+TWGPU_REFCOUNT_FUNCTIONS(CommandEncoder, WGPUCommandEncoder)
+TWGPU_REFCOUNT_FUNCTIONS(ComputePassEncoder, WGPUComputePassEncoder)
+TWGPU_REFCOUNT_FUNCTIONS(ComputePipeline, WGPUComputePipeline)
+TWGPU_REFCOUNT_FUNCTIONS(Device, WGPUDevice)
+TWGPU_REFCOUNT_FUNCTIONS(PipelineLayout, WGPUPipelineLayout)
+TWGPU_REFCOUNT_FUNCTIONS(Queue, WGPUQueue)
+TWGPU_REFCOUNT_FUNCTIONS(ShaderModule, WGPUShaderModule)
+
+#undef TWGPU_REFCOUNT_FUNCTIONS
+
+} // extern "C"
diff --git a/torch/csrc/webgpu/webgpu_backend.cpp b/torch/csrc/webgpu/webgpu_backend.cpp
new file mode 100644
index 0000000..6be9b97
--- /dev/null
+++ b/torch/csrc/webgpu/webgpu_backend.cpp
@@ -0,0 +1,388 @@
+// Browser storage, device plumbing, copies, and metadata operators for the
+// torch-webgpu eager-kernel port. Compute dispatch itself uses the pinned
+// Emdawnwebgpu Dawn-style headers through emdawnwebgpu_bridge.cpp.
+
+#include <ATen/ATen.h>
+#include <ATen/EmptyTensor.h>
+#include <ATen/core/grad_mode.h>
+#include <ATen/ops/as_strided_cpu_dispatch.h>
+#include <ATen/ops/view_cpu_dispatch.h>
+#include <c10/core/Allocator.h>
+#include <c10/core/Device.h>
+#include <c10/core/Stream.h>
+#include <c10/core/impl/DeviceGuardImplInterface.h>
+#include <torch/library.h>
+#include <webgpu/webgpu_cpp.h>
+
+#include "core/webgpu_allocator.h"
+#include "core/webgpu_context.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <utility>
+
+namespace torch_webgpu::browser {
+namespace {
+
+using core::WebGPUAllocation;
+
+void delete_allocation(void* pointer) {
+  delete static_cast<WebGPUAllocation*>(pointer);
+}
+
+struct WebGPUAllocator final : c10::Allocator {
+  c10::DataPtr allocate(std::size_t nbytes) override {
+    if (nbytes == 0) {
+      return {
+          nullptr,
+          nullptr,
+          &delete_allocation,
+          c10::Device(c10::DeviceType::PrivateUse1, 0)};
+    }
+    TORCH_CHECK(
+        core::getWebGPUContext().is_initialized(),
+        "WebGPU is not initialized; call `await torch.webgpu.init()` first");
+    TORCH_CHECK(
+        nbytes <= UINT32_MAX - std::size_t(3),
+        "WebGPU allocation is too large: ",
+        nbytes,
+        " bytes");
+    const auto aligned_nbytes = (nbytes + 3) & ~std::size_t(3);
+    wgpu::BufferDescriptor descriptor{};
+    descriptor.label = "PyTorch WebGPU tensor";
+    descriptor.size = aligned_nbytes;
+    descriptor.usage = wgpu::BufferUsage::CopyDst |
+        wgpu::BufferUsage::CopySrc | wgpu::BufferUsage::Storage;
+    descriptor.mappedAtCreation = false;
+    auto buffer = core::getWebGPUContext().getDevice().CreateBuffer(&descriptor);
+    TORCH_CHECK(buffer != nullptr, "WebGPU buffer allocation failed");
+    auto* allocation =
+        new WebGPUAllocation(std::move(buffer), aligned_nbytes);
+    return {
+        allocation,
+        allocation,
+        &delete_allocation,
+        c10::Device(c10::DeviceType::PrivateUse1, 0)};
+  }
+
+  c10::DeleterFnPtr raw_deleter() const override {
+    return &delete_allocation;
+  }
+
+  void copy_data(
+      void*,
+      const void*,
+      std::size_t) const override {
+    TORCH_CHECK_NOT_IMPLEMENTED(
+        false,
+        "WebGPU allocator copy_data is unavailable; use tensor copy operators");
+  }
+};
+
+WebGPUAllocator& allocator() {
+  static WebGPUAllocator instance;
+  return instance;
+}
+
+WebGPUAllocation& allocation(const at::Tensor& tensor) {
+  TORCH_CHECK(tensor.device().is_privateuseone(), "expected a WebGPU tensor");
+  auto* result =
+      static_cast<WebGPUAllocation*>(tensor.storage().data_ptr().get());
+  TORCH_CHECK(result, "WebGPU tensor has no GPUBuffer storage");
+  return *result;
+}
+
+std::uint32_t checked_u32(std::int64_t value, const char* description) {
+  TORCH_CHECK(
+      value >= 0 &&
+          static_cast<std::uint64_t>(value) <=
+              std::numeric_limits<std::uint32_t>::max(),
+      description,
+      " does not fit in uint32 WebGPU metadata");
+  return static_cast<std::uint32_t>(value);
+}
+
+std::uint32_t checked_nbytes(const at::Tensor& tensor) {
+  return checked_u32(
+      tensor.numel() * tensor.element_size(), "tensor byte count");
+}
+
+void check_supported_tensor(
+    const at::Tensor& tensor,
+    const char* operation,
+    bool require_contiguous = true) {
+  TORCH_CHECK(
+      tensor.device().is_privateuseone(), operation, " expected a WebGPU tensor");
+  TORCH_CHECK(
+      tensor.scalar_type() == at::kFloat || tensor.scalar_type() == at::kInt,
+      operation,
+      " supports only torch.float32 and torch.int32");
+  TORCH_CHECK(
+      !require_contiguous || tensor.is_contiguous(),
+      operation,
+      " requires a contiguous tensor");
+  TORCH_CHECK(
+      tensor.storage_offset() >= 0,
+      operation,
+      " does not support negative storage offsets");
+}
+
+class WebGPUGuardImpl final : public c10::impl::DeviceGuardImplInterface {
+ public:
+  static constexpr c10::DeviceType static_type =
+      c10::DeviceType::PrivateUse1;
+
+  c10::DeviceType type() const override {
+    return static_type;
+  }
+
+  c10::Device exchangeDevice(c10::Device device) const override {
+    setDevice(device);
+    return c10::Device(static_type, 0);
+  }
+
+  c10::Device getDevice() const override {
+    return c10::Device(static_type, 0);
+  }
+
+  void setDevice(c10::Device device) const override {
+    TORCH_CHECK(
+        device.is_privateuseone() && device.index() <= 0,
+        "WebGPU supports only device 0");
+  }
+
+  void uncheckedSetDevice(c10::Device) const noexcept override {}
+
+  c10::DeviceIndex deviceCount() const noexcept override {
+    return core::getWebGPUContext().is_initialized() ? 1 : 0;
+  }
+
+  c10::Stream getStream(c10::Device device) const noexcept override {
+    return c10::Stream(c10::Stream::DEFAULT, device);
+  }
+
+  c10::Stream exchangeStream(c10::Stream stream) const noexcept override {
+    return c10::Stream(c10::Stream::DEFAULT, stream.device());
+  }
+};
+
+at::Tensor empty_memory_format(
+    c10::IntArrayRef size,
+    std::optional<at::ScalarType> dtype,
+    std::optional<at::Layout> layout,
+    std::optional<at::Device> device,
+    std::optional<bool> pin_memory,
+    std::optional<c10::MemoryFormat> memory_format) {
+  const auto resolved_dtype = c10::dtype_or_default(dtype);
+  TORCH_CHECK(
+      resolved_dtype == at::kFloat || resolved_dtype == at::kInt,
+      "WebGPU supports only torch.float32 and torch.int32");
+  TORCH_CHECK(
+      c10::layout_or_default(layout) == c10::Layout::Strided,
+      "WebGPU supports only strided tensors");
+  TORCH_CHECK(
+      !c10::pinned_memory_or_default(pin_memory),
+      "WebGPU tensors cannot be pinned");
+  if (device) {
+    TORCH_CHECK(
+        device->is_privateuseone() && device->index() <= 0,
+        "WebGPU supports only device 0");
+  }
+  constexpr c10::DispatchKeySet key_set(c10::DispatchKey::PrivateUse1);
+  return at::detail::empty_generic(
+      size, &allocator(), key_set, resolved_dtype, memory_format);
+}
+
+at::Tensor empty_strided(
+    c10::IntArrayRef size,
+    c10::IntArrayRef stride,
+    std::optional<at::ScalarType> dtype,
+    std::optional<at::Layout> layout,
+    std::optional<at::Device> device,
+    std::optional<bool> pin_memory) {
+  const auto resolved_dtype = c10::dtype_or_default(dtype);
+  TORCH_CHECK(
+      resolved_dtype == at::kFloat || resolved_dtype == at::kInt,
+      "WebGPU supports only torch.float32 and torch.int32");
+  TORCH_CHECK(
+      c10::layout_or_default(layout) == c10::Layout::Strided,
+      "WebGPU supports only strided tensors");
+  TORCH_CHECK(
+      !c10::pinned_memory_or_default(pin_memory),
+      "WebGPU tensors cannot be pinned");
+  if (device) {
+    TORCH_CHECK(
+        device->is_privateuseone() && device->index() <= 0,
+        "WebGPU supports only device 0");
+  }
+  constexpr c10::DispatchKeySet key_set(c10::DispatchKey::PrivateUse1);
+  return at::detail::empty_strided_generic(
+      size, stride, &allocator(), key_set, resolved_dtype);
+}
+
+at::Tensor as_strided(
+    const at::Tensor& tensor,
+    c10::SymIntArrayRef size,
+    c10::SymIntArrayRef stride,
+    std::optional<c10::SymInt> storage_offset) {
+  check_supported_tensor(tensor, "WebGPU as_strided", false);
+  return at::cpu::as_strided_symint(
+      tensor, size, stride, std::move(storage_offset));
+}
+
+at::Tensor view(const at::Tensor& tensor, c10::SymIntArrayRef size) {
+  check_supported_tensor(tensor, "WebGPU view", false);
+  return at::cpu::view_symint(tensor, size);
+}
+
+at::Tensor copy_from(
+    const at::Tensor& source,
+    const at::Tensor& destination,
+    bool /*non_blocking*/) {
+  TORCH_CHECK(source.defined(), "source tensor is not defined");
+  TORCH_CHECK(destination.defined(), "destination tensor is not defined");
+
+  if (source.device().is_cpu() && destination.device().is_privateuseone()) {
+    check_supported_tensor(destination, "CPU to WebGPU copy");
+    TORCH_CHECK(
+        source.scalar_type() == destination.scalar_type(),
+        "CPU to WebGPU copy requires matching dtypes");
+    TORCH_CHECK(
+        source.scalar_type() == at::kFloat || source.scalar_type() == at::kInt,
+        "CPU to WebGPU copy supports only torch.float32 and torch.int32");
+    TORCH_CHECK(source.sizes() == destination.sizes(), "copy shape mismatch");
+    const auto contiguous_source =
+        source.is_contiguous() ? source : source.contiguous();
+    const auto nbytes = checked_nbytes(contiguous_source);
+    if (nbytes == 0) {
+      return destination;
+    }
+    auto& destination_allocation = allocation(destination);
+    const auto destination_offset = checked_u32(
+        destination.storage_offset() * destination.element_size(),
+        "destination byte offset");
+    TORCH_CHECK(
+        static_cast<std::uint64_t>(destination_offset) + nbytes <=
+            destination_allocation.nbytes,
+        "CPU to WebGPU copy exceeds destination storage");
+    core::getWebGPUContext().getQueue().WriteBuffer(
+        destination_allocation.buffer,
+        destination_offset,
+        contiguous_source.data_ptr(),
+        nbytes);
+    return destination;
+  }
+
+  if (source.device().is_privateuseone() &&
+      destination.device().is_privateuseone()) {
+    check_supported_tensor(source, "WebGPU copy");
+    check_supported_tensor(destination, "WebGPU copy");
+    TORCH_CHECK(
+        source.scalar_type() == destination.scalar_type(),
+        "WebGPU copy requires matching dtypes");
+    TORCH_CHECK(source.sizes() == destination.sizes(), "copy shape mismatch");
+    const auto nbytes = checked_nbytes(source);
+    if (nbytes == 0) {
+      return destination;
+    }
+    auto& source_allocation = allocation(source);
+    auto& destination_allocation = allocation(destination);
+    const auto source_offset = checked_u32(
+        source.storage_offset() * source.element_size(),
+        "source byte offset");
+    const auto destination_offset = checked_u32(
+        destination.storage_offset() * destination.element_size(),
+        "destination byte offset");
+    TORCH_CHECK(
+        static_cast<std::uint64_t>(source_offset) + nbytes <=
+            source_allocation.nbytes,
+        "WebGPU copy exceeds source storage");
+    TORCH_CHECK(
+        static_cast<std::uint64_t>(destination_offset) + nbytes <=
+            destination_allocation.nbytes,
+        "WebGPU copy exceeds destination storage");
+    if (source_allocation.buffer.Get() == destination_allocation.buffer.Get()) {
+      TORCH_CHECK(
+          source_offset == destination_offset,
+          "WebGPU copy between different views of the same GPUBuffer is not "
+          "supported");
+      return destination;
+    }
+    auto encoder =
+        core::getWebGPUContext().getDevice().CreateCommandEncoder();
+    encoder.CopyBufferToBuffer(
+        source_allocation.buffer,
+        source_offset,
+        destination_allocation.buffer,
+        destination_offset,
+        nbytes);
+    auto command_buffer = encoder.Finish();
+    core::getWebGPUContext().getQueue().Submit(1, &command_buffer);
+    return destination;
+  }
+
+  if (source.device().is_privateuseone() && destination.device().is_cpu()) {
+    TORCH_CHECK(
+        false,
+        "browser WebGPU readback is asynchronous; use "
+        "`await torch.webgpu.to_cpu_async(tensor)` instead of `.cpu()`");
+  }
+
+  TORCH_CHECK(
+      false,
+      "unsupported WebGPU copy: ",
+      source.device(),
+      " -> ",
+      destination.device());
+}
+
+void initialize() {
+  core::getWebGPUContext().initialize();
+}
+
+std::int64_t buffer_id(const at::Tensor& tensor) {
+  if (tensor.numel() == 0) {
+    return 0;
+  }
+  return static_cast<std::int64_t>(reinterpret_cast<std::uintptr_t>(
+      allocation(tensor).buffer.Get()));
+}
+
+std::int64_t buffer_nbytes(const at::Tensor& tensor) {
+  return checked_nbytes(tensor);
+}
+
+} // namespace
+
+C10_REGISTER_GUARD_IMPL(PrivateUse1, WebGPUGuardImpl);
+
+TORCH_LIBRARY_IMPL(aten, PrivateUse1, module) {
+  module.impl("empty.memory_format", TORCH_FN(empty_memory_format));
+  module.impl("empty_strided", TORCH_FN(empty_strided));
+  module.impl("as_strided", TORCH_FN(as_strided));
+  module.impl("view", TORCH_FN(view));
+  module.impl("_copy_from", TORCH_FN(copy_from));
+}
+
+TORCH_LIBRARY(webgpu, module) {
+  module.def("initialize() -> ()");
+  module.def("buffer_id(Tensor tensor) -> int");
+  module.def("buffer_nbytes(Tensor tensor) -> int");
+}
+
+TORCH_LIBRARY_IMPL(webgpu, CatchAll, module) {
+  module.impl("initialize", TORCH_FN(initialize));
+}
+
+TORCH_LIBRARY_IMPL(webgpu, PrivateUse1, module) {
+  module.impl("buffer_id", TORCH_FN(buffer_id));
+  module.impl("buffer_nbytes", TORCH_FN(buffer_nbytes));
+}
+
+TORCH_LIBRARY_IMPL(_, AutogradPrivateUse1, module) {
+  module.fallback(torch::CppFunction::makeFallthrough());
+}
+
+} // namespace torch_webgpu::browser
diff --git a/torch/csrc/webgpu/webgpu_context.cpp b/torch/csrc/webgpu/webgpu_context.cpp
