index 0000000..23bdf1a
--- /dev/null
+++ b/torch/csrc/webgpu/webgpu_context.cpp
@@ -0,0 +1,44 @@
+#include "core/webgpu_context.h"
+
+#include <c10/util/Exception.h>
+
+#include <cstdint>
+
+namespace torch_webgpu::core {
+namespace {
+
+constexpr std::uintptr_t kBrowserDeviceHandle = 1;
+constexpr std::uintptr_t kBrowserQueueHandle = 2;
+
+} // namespace
+
+void WebGPUContext::initialize() {
+  if (is_initialized()) {
+    return;
+  }
+  device_ = wgpu::Device::Acquire(
+      reinterpret_cast<WGPUDevice>(kBrowserDeviceHandle));
+  queue_ = wgpu::Queue::Acquire(
+      reinterpret_cast<WGPUQueue>(kBrowserQueueHandle));
+}
+
+bool WebGPUContext::is_initialized() const {
+  return device_ != nullptr && queue_ != nullptr;
+}
+
+wgpu::Device WebGPUContext::getDevice() const {
+  TORCH_CHECK(is_initialized(), "WebGPU native context is not initialized");
+  return device_;
+}
+
+wgpu::Queue WebGPUContext::getQueue() const {
+  TORCH_CHECK(is_initialized(), "WebGPU native context is not initialized");
+  return queue_;
+}
+
+WebGPUContext& getWebGPUContext() {
+  static WebGPUContext context;
+  return context;
+}
+
+} // namespace torch_webgpu::core
diff --git a/torch/webgpu/__init__.py b/torch/webgpu/__init__.py
new file mode 100644
index 0000000..dc774e8
--- /dev/null
+++ b/torch/webgpu/__init__.py
@@ -0,0 +1,295 @@
+"""Experimental browser WebGPU backend for the Pyodide PyTorch build.
+
+GPU storage and ATen dispatch are implemented in C++ using PyTorch's
+``PrivateUse1`` extension points. Browser WebGPU commands are issued through
+an Emscripten JavaScript bridge embedded in ``torch._C``. GPU work is enqueued
+synchronously, while readback is explicitly asynchronous because WebGPU does
+not expose synchronous buffer mapping.
+"""
+
+from __future__ import annotations
+
+import sys
+from typing import Any
+
+import torch
+
+_adapter: Any | None = None
+_device: Any | None = None
+
+
+def _js() -> Any:
+    try:
+        import js
+    except ImportError as exc:  # pragma: no cover - browser-only module
+        raise RuntimeError("the WebGPU backend requires Pyodide") from exc
+    return js
+
+
+def _js_object(**values: Any) -> Any:
+    result = _js().Object.new()
+    for key, value in values.items():
+        setattr(result, key, value)
+    return result
+
+
+def _js_array(*values: Any) -> Any:
+    result = _js().Array.new()
+    for value in values:
+        result.push(value)
+    return result
+
+
+def _state() -> Any:
+    state = getattr(_js().globalThis, "__torchWebGPU", None)
+    if state is None:
+        raise RuntimeError(
+            "WebGPU is not initialized; call `await torch.webgpu.init()` first"
+        )
+    return state
+
+
+async def init(*, device: Any | None = None) -> None:
+    """Initialize the browser GPUDevice used by the compiled backend."""
+
+    global _adapter, _device
+
+    if is_initialized():
+        return
+    if device is None:
+        gpu = getattr(_js().navigator, "gpu", None)
+        if not gpu:
+            raise RuntimeError("WebGPU is not exposed by this browser/runtime")
+        _adapter = await gpu.requestAdapter(
+            _js_object(powerPreference="high-performance")
+        )
+        # Pyodide 314 represents JavaScript null as the falsey `jsnull`
+        # singleton rather than Python None.
+        if not _adapter:
+            raise RuntimeError("the browser did not provide a WebGPU adapter")
+        device = await _adapter.requestDevice()
+
+    objects = _js().Map.new()
+    buffers = _js().Map.new()
+    state = _js_object(
