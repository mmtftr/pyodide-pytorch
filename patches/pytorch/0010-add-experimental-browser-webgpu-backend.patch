+// Browser-safe registrations built from torch-webgpu's existing C++ dispatch
+// helpers and WGSL. This file intentionally omits every upstream registration
+// that can synchronously read back or invoke a CPU fallback.
+
+#include <ATen/ATen.h>
+#include <ATen/TensorIterator.h>
+#include <ATen/core/grad_mode.h>
+#include <torch/library.h>
+#include <webgpu/webgpu_cpp.h>
+
+#include "binary.h"
+#include "core/webgpu_allocator.h"
+#include "core/webgpu_context.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace torch_webgpu::browser_ops {
+namespace {
+
+using torch_webgpu::core::WebGPUAllocation;
+using torch_webgpu::ops::BinaryOp;
+
+void check_float_webgpu(const at::Tensor& tensor, const char* operation) {
+  TORCH_CHECK(
+      tensor.device().is_privateuseone(), operation, " expects a WebGPU tensor");
+  TORCH_CHECK(
+      tensor.scalar_type() == at::kFloat,
+      operation,
+      " supports only torch.float32");
+  TORCH_CHECK(
+      !at::GradMode::is_enabled() || !tensor.requires_grad(),
+      "WebGPU autograd is not supported; use `torch.no_grad()` for inference");
+}
+
+std::uint32_t checked_u32(std::int64_t value, const char* description) {
+  TORCH_CHECK(
+      value >= 0 &&
+          static_cast<std::uint64_t>(value) <=
+              std::numeric_limits<std::uint32_t>::max(),
+      description,
+      " does not fit in uint32 WebGPU metadata");
+  return static_cast<std::uint32_t>(value);
+}
+
+template <BinaryOp Op>
+at::Tensor& binary_out(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    const at::Scalar& alpha,
+    at::Tensor& output) {
+  check_float_webgpu(lhs, "WebGPU binary operation");
+  check_float_webgpu(rhs, "WebGPU binary operation");
+  check_float_webgpu(output, "WebGPU binary output");
+  TORCH_CHECK(lhs.device() == rhs.device() && lhs.device() == output.device());
+
+  at::TensorIteratorConfig config;
+  config.set_check_mem_overlap(true);
+  config.add_output(output);
+  config.add_input(lhs);
+  config.add_input(rhs);
+  config.check_all_same_dtype(true);
+  config.check_all_same_device(true);
+  auto iterator = config.build();
+  torch_webgpu::ops::run_binary_kernel<Op>(iterator, alpha);
+  return output;
+}
+
+template <BinaryOp Op>
+at::Tensor binary_tensor(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    const at::Scalar& alpha = 1) {
+  check_float_webgpu(lhs, "WebGPU binary operation");
+  check_float_webgpu(rhs, "WebGPU binary operation");
+  TORCH_CHECK(
+      lhs.device() == rhs.device(),
+      "WebGPU binary operations do not implicitly transfer CPU tensors");
+  auto output = at::empty(at::infer_size(lhs.sizes(), rhs.sizes()), lhs.options());
+  if (output.numel() == 0) {
+    return output;
+  }
+  binary_out<Op>(lhs, rhs, alpha, output);
+  return output;
+}
+
+at::Tensor add_tensor(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    const at::Scalar& alpha) {
+  return binary_tensor<BinaryOp::Add>(lhs, rhs, alpha);
+}
+
+at::Tensor& add_out(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    const at::Scalar& alpha,
+    at::Tensor& output) {
+  return binary_out<BinaryOp::Add>(lhs, rhs, alpha, output);
+}
+
+at::Tensor mul_tensor(const at::Tensor& lhs, const at::Tensor& rhs) {
+  return binary_tensor<BinaryOp::Mul>(lhs, rhs);
+}
+
+at::Tensor& mul_out(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    at::Tensor& output) {
+  return binary_out<BinaryOp::Mul>(lhs, rhs, 1, output);
+}
+
+at::Tensor sub_tensor(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    const at::Scalar& alpha) {
+  return binary_tensor<BinaryOp::Sub>(lhs, rhs, alpha);
+}
+
+at::Tensor& sub_out(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    const at::Scalar& alpha,
+    at::Tensor& output) {
+  return binary_out<BinaryOp::Sub>(lhs, rhs, alpha, output);
+}
+
+at::Tensor div_tensor(const at::Tensor& lhs, const at::Tensor& rhs) {
+  return binary_tensor<BinaryOp::Div>(lhs, rhs);
+}
+
+at::Tensor& div_out(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    at::Tensor& output) {
+  return binary_out<BinaryOp::Div>(lhs, rhs, 1, output);
+}
+
+struct ComputeKernel {
+  wgpu::BindGroupLayout bind_group_layout;
+  wgpu::ComputePipeline pipeline;
+};
+
+ComputeKernel make_kernel(
+    const char* label,
+    const std::string& shader,
+    const std::vector<wgpu::BufferBindingType>& binding_types) {
+  wgpu::ShaderSourceWGSL shader_source{
+      wgpu::ShaderSourceWGSL::Init{
+          nullptr,
+          wgpu::StringView{shader.c_str(), shader.size()}}};
+  wgpu::ShaderModuleDescriptor shader_descriptor{};
+  shader_descriptor.nextInChain = &shader_source;
+  shader_descriptor.label = label;
+  auto& context = torch_webgpu::core::getWebGPUContext();
+  auto shader_module =
+      context.getDevice().CreateShaderModule(&shader_descriptor);
+
+  std::vector<wgpu::BindGroupLayoutEntry> entries(binding_types.size());
+  for (std::size_t index = 0; index < binding_types.size(); ++index) {
+    entries[index].binding = static_cast<std::uint32_t>(index);
+    entries[index].visibility = wgpu::ShaderStage::Compute;
+    entries[index].buffer.type = binding_types[index];
+    entries[index].buffer.hasDynamicOffset = false;
+    entries[index].buffer.minBindingSize = 0;
+  }
+  wgpu::BindGroupLayoutDescriptor layout_descriptor{};
+  layout_descriptor.entryCount = entries.size();
+  layout_descriptor.entries = entries.data();
+  auto bind_group_layout =
+      context.getDevice().CreateBindGroupLayout(&layout_descriptor);
+
+  wgpu::PipelineLayoutDescriptor pipeline_layout_descriptor{};
+  pipeline_layout_descriptor.bindGroupLayoutCount = 1;
+  pipeline_layout_descriptor.bindGroupLayouts = &bind_group_layout;
+  auto pipeline_layout =
+      context.getDevice().CreatePipelineLayout(&pipeline_layout_descriptor);
+
+  wgpu::ComputePipelineDescriptor pipeline_descriptor{};
+  pipeline_descriptor.layout = pipeline_layout;
+  pipeline_descriptor.compute.module = shader_module;
+  pipeline_descriptor.compute.entryPoint = wgpu::StringView{"main", 4};
+  auto pipeline =
+      context.getDevice().CreateComputePipeline(&pipeline_descriptor);
+  TORCH_CHECK(
+      bind_group_layout != nullptr && pipeline != nullptr,
+      "failed to create ",
+      label,
+      " WebGPU pipeline");
+  return {std::move(bind_group_layout), std::move(pipeline)};
+}
+
+const std::string& mm_shader() {
+  // Verbatim executable WGSL from torch-webgpu csrc/shaders/mm.wgsl at
+  // a4369ff0f61f4e58cbffb048cee85047b33dacba (comments omitted).
+  static const std::string shader = R"wgsl(
+const MAX_DIMS: u32 = 8u;
+
+struct Params {
+    M: u32,
+    N: u32,
+    K: u32,
+    _pad: u32,
+    self_offset: u32,
+    mat2_offset: u32,
+    out_offset: u32,
+    _pad2: u32,
+    self_strides: array<u32, MAX_DIMS>,
+    mat2_strides: array<u32, MAX_DIMS>,
+    out_strides: array<u32, MAX_DIMS>,
+};
+
+@group(0) @binding(0) var<storage, read> A: array<f32>;
+@group(0) @binding(1) var<storage, read> B: array<f32>;
+@group(0) @binding(2) var<storage, read_write> C: array<f32>;
+@group(0) @binding(3) var<uniform> params: Params;
+
+const wsx: u32 = 16u;
+const wsy: u32 = 16u;
+const wsz: u32 = 1u;
+
+@compute @workgroup_size(wsx, wsy)
+fn main(
+    @builtin(workgroup_id) wid: vec3<u32>,
+    @builtin(local_invocation_index) li: u32,
+    @builtin(num_workgroups) nwg: vec3<u32>) {
+    let workgroup_index = wid.x + nwg.x * wid.y + nwg.x * nwg.y * wid.z;
+    let index = workgroup_index * (wsx * wsy * wsz) + li;
+    if (index >= params.M * params.K) { return; }
+    let row = index / params.K;
+    let column = index % params.K;
+    var output: f32 = 0.0;
+    for (var i: u32 = 0u; i < params.N; i++) {
+        let a = params.self_offset + row * params.self_strides[0] +
+            i * params.self_strides[1];
+        let b = params.mat2_offset + i * params.mat2_strides[0] +
+            column * params.mat2_strides[1];
+        output += A[a] * B[b];
+    }
+    C[params.out_offset + index] = output;
+}
+)wgsl";
+  return shader;
+}
+
+ComputeKernel& mm_kernel() {
+  static ComputeKernel kernel = make_kernel(
+      "torch-webgpu mm",
+      mm_shader(),
+      {wgpu::BufferBindingType::ReadOnlyStorage,
+       wgpu::BufferBindingType::ReadOnlyStorage,
+       wgpu::BufferBindingType::Storage,
+       wgpu::BufferBindingType::Uniform});
+  return kernel;
+}
+
+at::Tensor& mm_out(
+    const at::Tensor& lhs,
+    const at::Tensor& rhs,
+    at::Tensor& output) {
+  check_float_webgpu(lhs, "WebGPU mm");
+  check_float_webgpu(rhs, "WebGPU mm");
+  check_float_webgpu(output, "WebGPU mm output");
+  TORCH_CHECK(lhs.dim() == 2 && rhs.dim() == 2, "WebGPU mm expects matrices");
+  TORCH_CHECK(lhs.size(1) == rhs.size(0), "WebGPU mm shape mismatch");
+  TORCH_CHECK(
+      output.dim() == 2 && output.size(0) == lhs.size(0) &&
+          output.size(1) == rhs.size(1),
+      "WebGPU mm output shape mismatch");
+  TORCH_CHECK(output.is_contiguous(), "WebGPU mm output must be contiguous");
+  if (output.numel() == 0) {
+    return output;
+  }
+
+  struct Params {
+    std::uint32_t m;
+    std::uint32_t n;
+    std::uint32_t k;
+    std::uint32_t pad;
+    std::uint32_t lhs_offset;
+    std::uint32_t rhs_offset;
+    std::uint32_t output_offset;
+    std::uint32_t pad2;
+    std::uint32_t lhs_strides[8];
+    std::uint32_t rhs_strides[8];
+    std::uint32_t output_strides[8];
+  };
+  static_assert(sizeof(Params) == 128);
+  Params params{};
+  params.m = checked_u32(lhs.size(0), "mm M");
+  params.n = checked_u32(lhs.size(1), "mm N");
+  params.k = checked_u32(rhs.size(1), "mm K");
+  params.lhs_offset = checked_u32(lhs.storage_offset(), "mm lhs offset");
+  params.rhs_offset = checked_u32(rhs.storage_offset(), "mm rhs offset");
+  params.output_offset =
+      checked_u32(output.storage_offset(), "mm output offset");
+  params.lhs_strides[0] = checked_u32(lhs.stride(0), "mm lhs stride 0");
+  params.lhs_strides[1] = checked_u32(lhs.stride(1), "mm lhs stride 1");
+  params.rhs_strides[0] = checked_u32(rhs.stride(0), "mm rhs stride 0");
+  params.rhs_strides[1] = checked_u32(rhs.stride(1), "mm rhs stride 1");
+  params.output_strides[0] =
+      checked_u32(output.stride(0), "mm output stride 0");
+  params.output_strides[1] =
+      checked_u32(output.stride(1), "mm output stride 1");
+
+  auto* lhs_allocation =
+      static_cast<WebGPUAllocation*>(lhs.storage().data_ptr().get());
+  auto* rhs_allocation =
+      static_cast<WebGPUAllocation*>(rhs.storage().data_ptr().get());
+  auto* output_allocation =
+      static_cast<WebGPUAllocation*>(output.storage().data_ptr().get());
+  TORCH_CHECK(lhs_allocation && rhs_allocation && output_allocation);
+
+  auto& context = torch_webgpu::core::getWebGPUContext();
+  wgpu::BufferDescriptor uniform_descriptor{};
+  uniform_descriptor.label = "torch-webgpu mm params";
+  uniform_descriptor.usage =
+      wgpu::BufferUsage::Uniform | wgpu::BufferUsage::CopyDst;
+  uniform_descriptor.size = sizeof(Params);
+  auto params_buffer =
+      context.getDevice().CreateBuffer(&uniform_descriptor);
+  context.getQueue().WriteBuffer(params_buffer, 0, &params, sizeof(params));
+
+  auto& kernel = mm_kernel();
+  wgpu::BindGroupEntry entries[4]{};
+  entries[0].binding = 0;
+  entries[0].buffer = lhs_allocation->buffer;
+  entries[0].size = lhs_allocation->buffer.GetSize();
+  entries[1].binding = 1;
+  entries[1].buffer = rhs_allocation->buffer;
+  entries[1].size = rhs_allocation->buffer.GetSize();
+  entries[2].binding = 2;
+  entries[2].buffer = output_allocation->buffer;
+  entries[2].size = output_allocation->buffer.GetSize();
+  entries[3].binding = 3;
+  entries[3].buffer = params_buffer;
+  entries[3].size = sizeof(Params);
+  wgpu::BindGroupDescriptor bind_group_descriptor{};
+  bind_group_descriptor.layout = kernel.bind_group_layout;
+  bind_group_descriptor.entryCount = 4;
+  bind_group_descriptor.entries = entries;
+  auto bind_group =
+      context.getDevice().CreateBindGroup(&bind_group_descriptor);
+
+  auto encoder = context.getDevice().CreateCommandEncoder();
+  auto pass = encoder.BeginComputePass();
+  pass.SetPipeline(kernel.pipeline);
+  pass.SetBindGroup(0, bind_group);
+  pass.DispatchWorkgroups((params.m + 15) / 16, (params.k + 15) / 16, 1);
+  pass.End();
+  auto command_buffer = encoder.Finish();
+  context.getQueue().Submit(1, &command_buffer);
+  return output;
+}
+
+at::Tensor mm(const at::Tensor& lhs, const at::Tensor& rhs) {
+  check_float_webgpu(lhs, "WebGPU mm");
+  check_float_webgpu(rhs, "WebGPU mm");
+  TORCH_CHECK(lhs.dim() == 2 && rhs.dim() == 2, "WebGPU mm expects matrices");
+  TORCH_CHECK(lhs.size(1) == rhs.size(0), "WebGPU mm shape mismatch");
+  auto output = at::empty({lhs.size(0), rhs.size(1)}, lhs.options());
+  return mm_out(lhs, rhs, output);
+}
+
+const std::string& softmax_shader() {
+  // Executable WGSL from torch-webgpu csrc/ops/softmax.cpp at the pinned
+  // commit, retained as a single-invocation-per-row reference kernel.
+  static const std::string shader = R"wgsl(
+struct Params {
+    batch_size: u32,
+    dim_size: u32,
+    self_offset: u32,
+    out_offset: u32,
+};
+@group(0) @binding(0) var<storage, read> input: array<f32>;
+@group(0) @binding(1) var<storage, read_write> output: array<f32>;
+@group(0) @binding(2) var<uniform> params: Params;
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+    let batch = gid.x;
+    if (batch >= params.batch_size) { return; }
+    let input_base = params.self_offset + batch * params.dim_size;
+    let output_base = params.out_offset + batch * params.dim_size;
+    var maximum = input[input_base];
+    for (var i: u32 = 1u; i < params.dim_size; i++) {
+        maximum = max(maximum, input[input_base + i]);
+    }
+    var sum: f32 = 0.0;
+    for (var i: u32 = 0u; i < params.dim_size; i++) {
+        let value = exp(input[input_base + i] - maximum);
+        output[output_base + i] = value;
+        sum += value;
+    }
+    for (var i: u32 = 0u; i < params.dim_size; i++) {
+        output[output_base + i] /= sum;
+    }
+}
+)wgsl";
+  return shader;
+}
+
+ComputeKernel& softmax_kernel() {
+  static ComputeKernel kernel = make_kernel(
+      "torch-webgpu softmax",
+      softmax_shader(),
+      {wgpu::BufferBindingType::ReadOnlyStorage,
+       wgpu::BufferBindingType::Storage,
+       wgpu::BufferBindingType::Uniform});
+  return kernel;
+}
+
+at::Tensor browser_softmax(
+    const at::Tensor& input,
+    std::int64_t dim,
+    std::optional<at::ScalarType> dtype) {
+  check_float_webgpu(input, "WebGPU softmax");
+  if (dim < 0) {
+    dim += input.dim();
+  }
+  TORCH_CHECK(input.dim() > 0 && dim == input.dim() - 1,
+      "browser WebGPU softmax currently supports only the last dimension");
+  TORCH_CHECK(input.is_contiguous(),
+      "browser WebGPU softmax requires contiguous input");
+  TORCH_CHECK(!dtype || *dtype == at::kFloat,
+      "browser WebGPU softmax supports only float32 output");
+  auto output = at::empty_like(input);
+  if (input.numel() == 0) {
+    return output;
+  }
+  TORCH_CHECK(input.size(-1) > 0, "softmax dimension must be non-empty");
+
+  struct Params {
+    std::uint32_t batch_size;
+    std::uint32_t dim_size;
+    std::uint32_t input_offset;
+    std::uint32_t output_offset;
+  };
+  Params params{
+      checked_u32(input.numel() / input.size(-1), "softmax batch size"),
+      checked_u32(input.size(-1), "softmax dimension size"),
+      checked_u32(input.storage_offset(), "softmax input offset"),
+      checked_u32(output.storage_offset(), "softmax output offset")};
+  auto* input_allocation =
+      static_cast<WebGPUAllocation*>(input.storage().data_ptr().get());
+  auto* output_allocation =
+      static_cast<WebGPUAllocation*>(output.storage().data_ptr().get());
+  TORCH_CHECK(input_allocation && output_allocation);
+
+  auto& context = torch_webgpu::core::getWebGPUContext();
+  wgpu::BufferDescriptor uniform_descriptor{};
+  uniform_descriptor.label = "torch-webgpu softmax params";
+  uniform_descriptor.usage =
+      wgpu::BufferUsage::Uniform | wgpu::BufferUsage::CopyDst;
+  uniform_descriptor.size = sizeof(Params);
+  auto params_buffer =
+      context.getDevice().CreateBuffer(&uniform_descriptor);
+  context.getQueue().WriteBuffer(params_buffer, 0, &params, sizeof(params));
+
+  auto& kernel = softmax_kernel();
+  wgpu::BindGroupEntry entries[3]{};
+  entries[0].binding = 0;
+  entries[0].buffer = input_allocation->buffer;
+  entries[0].size = input_allocation->buffer.GetSize();
+  entries[1].binding = 1;
+  entries[1].buffer = output_allocation->buffer;
+  entries[1].size = output_allocation->buffer.GetSize();
+  entries[2].binding = 2;
+  entries[2].buffer = params_buffer;
+  entries[2].size = sizeof(Params);
+  wgpu::BindGroupDescriptor bind_group_descriptor{};
+  bind_group_descriptor.layout = kernel.bind_group_layout;
+  bind_group_descriptor.entryCount = 3;
+  bind_group_descriptor.entries = entries;
+  auto bind_group =
+      context.getDevice().CreateBindGroup(&bind_group_descriptor);
+
+  auto encoder = context.getDevice().CreateCommandEncoder();
+  auto pass = encoder.BeginComputePass();
+  pass.SetPipeline(kernel.pipeline);
+  pass.SetBindGroup(0, bind_group);
+  pass.DispatchWorkgroups((params.batch_size + 63) / 64, 1, 1);
+  pass.End();
+  auto command_buffer = encoder.Finish();
+  context.getQueue().Submit(1, &command_buffer);
+  return output;
+}
+
+at::Tensor& softmax_out(
+    const at::Tensor& input,
+    std::int64_t dim,
+    std::optional<at::ScalarType> dtype,
+    at::Tensor& output) {
+  auto result = browser_softmax(input, dim, dtype);
+  output.copy_(result);
+  return output;
+}
+
+at::Tensor log_softmax(
+    const at::Tensor& input,
+    std::int64_t dim,
+    std::optional<at::ScalarType> dtype) {
+  return at::log(browser_softmax(input, dim, dtype));
+}
+
+at::Tensor unsupported_argmax(
+    const at::Tensor&,
+    std::optional<std::int64_t>,
+    bool) {
+  TORCH_CHECK_NOT_IMPLEMENTED(
+      false,
+      "argmax is unsupported on browser WebGPU because the upstream "
+      "implementation requires synchronous CPU fallback");
+  return {};
+}
+
+} // namespace
+
+TORCH_LIBRARY_IMPL(aten, PrivateUse1, module) {
+  module.impl("add.Tensor", TORCH_FN(add_tensor));
+  module.impl("add.out", TORCH_FN(add_out));
+  module.impl("mul.Tensor", TORCH_FN(mul_tensor));
+  module.impl("mul.out", TORCH_FN(mul_out));
+  module.impl("sub.Tensor", TORCH_FN(sub_tensor));
+  module.impl("sub.out", TORCH_FN(sub_out));
+  module.impl("div.Tensor", TORCH_FN(div_tensor));
+  module.impl("div.out", TORCH_FN(div_out));
+  module.impl("mm", TORCH_FN(mm));
+  module.impl("mm.out", TORCH_FN(mm_out));
+  module.impl("softmax.int", TORCH_FN(browser_softmax));
+  module.impl("softmax.int_out", TORCH_FN(softmax_out));
+  module.impl("log_softmax.int", TORCH_FN(log_softmax));
+  module.impl("argmax", TORCH_FN(unsupported_argmax));
+}
