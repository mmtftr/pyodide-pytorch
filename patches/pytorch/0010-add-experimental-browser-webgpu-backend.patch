+"""Experimental browser WebGPU backend for the Pyodide PyTorch build.
+
+GPU storage and ATen dispatch are implemented in C++ using PyTorch's
+``PrivateUse1`` extension points. Browser WebGPU commands are issued through
+an Emscripten JavaScript bridge embedded in ``torch._C``. GPU work is enqueued
+synchronously, while readback is explicitly asynchronous because WebGPU does
+not expose synchronous buffer mapping.
+"""
+
+from __future__ import annotations
+
+import sys
+from typing import Any
+
+import torch
+
+_adapter: Any | None = None
+_device: Any | None = None
+
+
+def _js() -> Any:
+    try:
+        import js
+    except ImportError as exc:  # pragma: no cover - browser-only module
+        raise RuntimeError("the WebGPU backend requires Pyodide") from exc
+    return js
+
+
+def _js_object(**values: Any) -> Any:
+    result = _js().Object.new()
+    for key, value in values.items():
+        setattr(result, key, value)
+    return result
+
+
+def _js_array(*values: Any) -> Any:
+    result = _js().Array.new()
+    for value in values:
+        result.push(value)
+    return result
+
+
+def _state() -> Any:
+    state = getattr(_js().globalThis, "__torchWebGPU", None)
+    if state is None:
+        raise RuntimeError(
+            "WebGPU is not initialized; call `await torch_webgpu.init()` first"
+        )
+    return state
+
+
+async def init(*, device: Any | None = None) -> None:
+    """Initialize the browser GPUDevice used by the compiled backend."""
+
+    global _adapter, _device
+
+    if is_initialized():
+        return
+    if device is None:
+        gpu = getattr(_js().navigator, "gpu", None)
+        if gpu is None:
+            raise RuntimeError("WebGPU is not exposed by this browser/runtime")
+        _adapter = await gpu.requestAdapter(
+            _js_object(powerPreference="high-performance")
+        )
+        if _adapter is None:
+            raise RuntimeError("the browser did not provide a WebGPU adapter")
+        device = await _adapter.requestDevice()
+
+    state = _js_object(
+        device=device,
+        queue=device.queue,
+        buffers=_js().Map.new(),
+        pipelines=_js().Map.new(),
+        nextBufferId=1,
+        kernelSubmissions=0,
+        copySubmissions=0,
+    )
+    setattr(_js().globalThis, "__torchWebGPU", state)
+    _device = device
+
+
+async def synchronize() -> None:
+    """Wait for all commands submitted before this call."""
+
+    await _state().queue.onSubmittedWorkDone()
+
+
+async def to_cpu_async(tensor: torch.Tensor) -> torch.Tensor:
+    """Read a contiguous float32 WebGPU tensor into CPU memory."""
+
+    import numpy as np
+
+    if tensor.device.type != "webgpu":
+        raise TypeError(f"expected a WebGPU tensor, got {tensor.device}")
+    if tensor.dtype is not torch.float32:
+        raise NotImplementedError("WebGPU readback supports only torch.float32")
+    if not tensor.is_contiguous():
+        raise NotImplementedError("WebGPU readback requires a contiguous tensor")
+    nbytes = int(torch.ops.webgpu.buffer_nbytes(tensor))
+    if nbytes == 0:
+        return torch.empty(tuple(tensor.shape), dtype=tensor.dtype)
+
+    state = _state()
+    identifier = int(torch.ops.webgpu.buffer_id(tensor))
+    source = state.buffers.get(identifier)
+    if source is None:
+        raise RuntimeError("WebGPU tensor refers to a released GPUBuffer")
+
+    allocated_nbytes = max(4, nbytes)
+    readback = state.device.createBuffer(
+        _js_object(
+            label="PyTorch WebGPU readback",
+            size=allocated_nbytes,
+            usage=0x0001 | 0x0008,
+        )
+    )
+    encoder = state.device.createCommandEncoder(
+        _js_object(label="PyTorch WebGPU readback")
+    )
+    source_offset = int(tensor.storage_offset()) * tensor.element_size()
+    encoder.copyBufferToBuffer(
+        source, source_offset, readback, 0, allocated_nbytes
+    )
+    state.queue.submit(_js_array(encoder.finish()))
+    await readback.mapAsync(_js().GPUMapMode.READ)
+    try:
+        mapped = readback.getMappedRange(0, allocated_nbytes)
+        byte_view = _js().Uint8Array.new(mapped)
+        array = np.frombuffer(
+            byte_view.to_py(), dtype=np.float32, count=tensor.numel()
+        ).copy()
+    finally:
+        readback.unmap()
+        readback.destroy()
+    return torch.from_numpy(array).reshape(tuple(tensor.shape))
+
+
+def is_initialized() -> bool:
+    try:
+        state = getattr(_js().globalThis, "__torchWebGPU", None)
+        return (
+            state is not None
+            and getattr(state, "device", None) is not None
+            and getattr(state, "queue", None) is not None
+        )
+    except RuntimeError:
+        return False
+
+
+def is_available() -> bool:
+    if is_initialized():
+        return True
+    try:
+        return getattr(_js().navigator, "gpu", None) is not None
+    except RuntimeError:
+        return False
+
+
+def current_device() -> int:
+    return 0
+
+
+def device_count() -> int:
+    return 1 if is_available() else 0
+
+
+def get_amp_supported_dtype() -> list[torch.dtype]:
+    return [torch.float32]
+
+
+def _is_in_bad_fork() -> bool:
+    return False
+
+
+def manual_seed_all(seed: int) -> None:
+    del seed
+
+
+def kernel_submissions() -> int:
+    return int(_state().kernelSubmissions)
+
+
+def copy_submissions() -> int:
+    return int(_state().copySubmissions)
+
+
+def cpu_fallbacks() -> int:
+    """Return the number of implicit CPU fallbacks.
+
+    This initial backend does not register any CPU fallback path; unsupported
+    operations fail instead of silently moving tensor data off the GPU.
+    """
+
+    return 0
+
+
+torch.utils.rename_privateuse1_backend("webgpu")
+torch._register_device_module("webgpu", sys.modules[__name__])
+torch.utils.generate_methods_for_privateuse1_backend(
+    for_tensor=True,
+    for_module=True,
+    for_storage=True,
+    for_packed_sequence=True,
+)
+
+
+__all__ = [
+    "copy_submissions",
+    "cpu_fallbacks",
+    "current_device",
+    "device_count",
+    "get_amp_supported_dtype",
+    "init",
+    "is_available",
+    "is_initialized",
+    "kernel_submissions",
+    "synchronize",
+    "to_cpu_async",
+]
